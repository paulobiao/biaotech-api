PORT=3000
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# In production set to your frontend domain only.
CORS_ORIGIN=https://app.biaotech.dev,http://localhost:5173

JWT_SECRET=your_secret_here

# Password for the admin seed user. Required — seed will fail if not set.
ADMIN_PASSWORD=
JWT_EXPIRES_IN=1h

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=database